[Unit]
Description=AlcoSoft Telegram Experience Layer Daemon
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/alcosoft
Environment="PATH=/home/ubuntu/alcosoft/alco_env/bin"
ExecStart=/home/ubuntu/alcosoft/alco_env/bin/python /home/ubuntu/alcosoft/telegram_daemon.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
